          "pluginVersion": "4.11.4",
          "queryType": "table",
          "rawSql": "SELECT \r\n    sum(f.item_total_value) / uniqExact(c.customer_unique_id) AS \"Revenue per Customer\"\r\nFROM brazilian_ecommerce.fact_order_items f\r\nJOIN brazilian_ecommerce.dim_customers c ON f.customer_key = c.customer_key\r\nWHERE $__timeFilter(f.purchase_timestamp)\r\n  AND f.order_status NOT IN ('canceled', 'unavailable');",
          "refId": "A"
        }
      ],
      "title": "Revenue per Customer (RPC)",
      "type": "stat"
    },
