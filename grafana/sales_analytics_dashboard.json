          },
          "pluginVersion": "4.11.4",
          "queryType": "table",
          "rawSql": "SELECT \r\n    $__timeInterval(purchase_timestamp) AS time,\r\n    (countIf(order_status = 'canceled') / uniqExact(order_id)) * 100 AS \"Cancellation Rate %\",\r\n    countIf(order_status = 'canceled') AS \"Canceled Orders\",\r\n    uniqExact(order_id) AS \"Total Orders\"\r\nFROM brazilian_ecommerce.fact_order_items\r\nWHERE $__timeFilter(purchase_timestamp)\r\nGROUP BY time\r\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Cancellation Rate over Time",
      "type": "timeseries"
    },
