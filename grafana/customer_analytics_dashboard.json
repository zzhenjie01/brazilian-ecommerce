      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cf9rjcm0ndqtcd"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "",
              "limit": 1000,
              "mode": "list",
              "queryType": "table",
              "table": ""
            }
          },
          "pluginVersion": "4.11.4",
          "queryType": "table",
          "rawSql": "WITH customer_orders AS (\r\n    SELECT \r\n        c.customer_unique_id,\r\n        uniqExact(f.order_id) AS order_count,\r\n        sum(f.item_total_value) AS lifetime_value\r\n    FROM brazilian_ecommerce.fact_order_items f\r\n    JOIN brazilian_ecommerce.dim_customers c ON f.customer_key = c.customer_key\r\n    WHERE $__timeFilter(f.purchase_timestamp)\r\n      AND f.order_status NOT IN ('canceled', 'unavailable')\r\n    GROUP BY c.customer_unique_id\r\n)\r\nSELECT \r\n    CASE \r\n        WHEN order_count = 1 THEN '1 - One-time'\r\n        WHEN order_count = 2 THEN '2 - Repeat'\r\n        WHEN order_count BETWEEN 3 AND 5 THEN '3-5 - Regular'\r\n        ELSE '6+ - Loyal'\r\n    END AS \"Customer Segment\",\r\n    count() AS \"Customers\",\r\n    sum(lifetime_value) AS \"Total Revenue\"\r\nFROM customer_orders\r\nGROUP BY \"Customer Segment\"\r\nORDER BY \"Customers\" DESC;",
          "refId": "A"
        }
      ],
      "title": "Customer Segmentation",
      "type": "piechart"
    },
